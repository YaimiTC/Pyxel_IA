<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_import_deposit_wizard_form" model="ir.ui.view">
        <field name="name">import.deposit.wizard.form</field>
        <field name="model">import.deposit.wizard</field>
        <field name="arch" type="xml">
            <form string="Sincronización de Depósito">
                <group>
                    <field name="file" widget="binary" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <footer>
                    <button name="import_deposit_from_file" string="Sincronizar" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_import_deposit_wizard" model="ir.actions.act_window">
        <field name="name">Sincronización de Depósito</field>
        <field name="res_model">import.deposit.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_import_deposit_wizard"
              name="Depósito: Sincronizar datos recibidos"
              parent="menu_import_manager_root"
              action="action_import_deposit_wizard"
              sequence="12"/>

</odoo>
