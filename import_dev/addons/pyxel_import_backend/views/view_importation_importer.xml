<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record id="view_importation_importer_tree" model="ir.ui.view">
            <field name="name">importation.importer.tree</field>
            <field name="model">importation.importer</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="tcm_match_name" optional="show"/>
                    <field name="vat" optional="hide"/>
                    <field name="active" optional="hide"/>
                </tree>
            </field>
        </record>

        <record id="view_importation_importer_form" model="ir.ui.view">
            <field name="name">importation.importer.form</field>
            <field name="model">importation.importer</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <field name="logo" widget="image" class="oe_avatar"/>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                        </group>
                        <group string="Sincronización de Contenedores (TCM)">
                            <field name="tcm_match_name"/>
                            <field name="tcm_sync_start_date"/>
                        </group>
                        <group string="Datos Fiscales">
                            <group>
                                <field name="vat"/>
                                <field name="registro_comercial"/>
                                <field name="registro_mercantil"/>
                                <field name="street"/>
                            </group>
                            <group>
                                <field name="phone"/>
                                <field name="email"/>
                                <field name="bank_account_usd"/>
                                <field name="bank_account_cup"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_importation_importer" model="ir.actions.act_window">
            <field name="name">Importadoras</field>
            <field name="res_model">importation.importer</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="menu_importation_importer"
                  name="Importadoras"
                  parent="menu_importation_config"
                  action="action_importation_importer"
                  sequence="20"/>

</odoo>
